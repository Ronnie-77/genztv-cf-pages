# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — copy .env.example to .env and fill in real values
.env
.env.local
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# ── Cloudflare / OpenNext ──
.wrangler/
.open-next/
.dev.vars

# ── Local SQLite database (D1 is used in production) ──
db/*.db
db/*.db-journal
prisma/*.db
prisma/*.db-journal

# ── Prisma generated client (new prisma-client generator) ──
src/generated/

# ── Logs ──
*.log
dev.log
server.log

# ── Internal / sandbox-only ──
upload/
download/
tests/
examples/
mini-services/
skills/
.zscripts/
worklog.md
PROJECT_MEMORY.md
