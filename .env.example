# ═══════════════════════════════════════════════════════════════════
# GenZTV — Environment variables
# ═══════════════════════════════════════════════════════════════════
# Copy this file to `.env` for local development.
#
# For Cloudflare production, set these in wrangler.jsonc `vars` block
# (or via the Cloudflare dashboard → Workers → Settings → Variables).
# ═══════════════════════════════════════════════════════════════════

# ── LOCAL DEV ONLY ──────────────────────────────────────────────
# SQLite file path for local development. Ignored on Cloudflare (D1 is used).
DATABASE_URL="file:./db/custom.db"

# ── ADMIN AUTH ──────────────────────────────────────────────────
# Password for the admin panel (/#/admin). Change this before deploying!
ADMIN_PASSWORD="Ronnie7700"

# ── CLOUDFLARE DEPLOYMENT FLAG ──────────────────────────────────
# Set to "true" in wrangler.jsonc vars to enable D1 adapter.
# Do NOT set this in local .env — it would break local SQLite dev.
# CF_DEPLOY="true"

# ── WEB PUSH (OPTIONAL) ─────────────────────────────────────────
# Generate with: bunx web-push generate-vapid-keys
# Leave empty to disable web push notifications.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_PUBLIC_EMAIL="mailto:admin@example.com"

# ── LEGACY (not actively used) ──────────────────────────────────
NEXTAUTH_SECRET="change-me-in-production"
