# ═══════════════════════════════════════════════════
# GenZ TV — Cloudflare Pages + Neon PostgreSQL
# ═══════════════════════════════════════════════════
# Set these in the Cloudflare Dashboard → Pages → Settings → Environment Variables

# ── Neon PostgreSQL Database ──
# Get from: https://console.neon.tech → Connection Details
# Format: postgresql://user:pass@ep-xxx.region.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-your-project.region.neon.tech/neondb?sslmode=require

# ── Admin Authentication ──
ADMIN_PASSWORD=your_admin_password_here

# ── Web Push VAPID Keys ──
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your@email.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# ── Cron Security ──
# Used by external cron services (cron-job.org)
CRON_SECRET=your_cron_secret_here
CRON_REFRESH_SECRET=your_cron_refresh_secret_here

# ── Optional ──
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# FCM_SERVER_KEY=
